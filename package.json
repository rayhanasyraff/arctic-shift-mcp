{
  "name": "arctic-shift-mcp",
  "version": "1.0.2",
  "description": "MCP server for the Arctic Shift Reddit archive. Covers May 2025 to today (48h indexing lag). No API key required.",
  "main": "dist/index.js",
  "bin": {
    "arctic-shift-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const f='dist/index.js';fs.writeFileSync(f,'#!/usr/bin/env node\\n'+fs.readFileSync(f,'utf8'))\"",
    "dev": "tsc --watch",
    "start": "supergateway --stdio \"node dist/index.js\" --outputTransport streamableHttp --port $PORT --host 0.0.0.0 --healthEndpoint /healthz --apiKey \"$MCP_API_KEY\""
  },
  "keywords": [
    "mcp",
    "reddit",
    "arctic-shift",
    "archive"
  ],
  "author": "brayanguinand",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "supergateway": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  }
}
